# 腾讯云轻量应用服务器（Lighthouse）连接配置
# 使用方法：
#   1. 复制本文件为 .env        cp .env.example .env
#   2. 按下方说明填写 IP / 用户名 / 密码
#   3. 验证：python scripts/lh.py doctor
#
# 注意：.env 已被 .gitignore 忽略，不会提交到 GitHub。切勿把真实密码写进本模板。

# 服务器公网 IP（腾讯云控制台 → 轻量应用服务器 → 实例列表 → 公网 IP）
LH_HOST=1.2.3.4

# SSH 端口，默认 22
LH_PORT=22

# 登录用户名：Ubuntu 镜像为 ubuntu，Debian/CentOS/宝塔等镜像为 root
LH_USER=root

# 登录密码：在控制台「重置密码」设置；使用密钥登录时留空
LH_PASSWORD=your-password-here

# 可选：私钥文件路径（配置后优先于密码登录，Windows 路径示例 E:/keys/id_rsa）
LH_KEY_PATH=

# 连接超时（秒）
LH_TIMEOUT=15
